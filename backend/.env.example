# ---- General ----
APP_ENV=dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Active vision provider: gemini | mistral | cloudflare | ollama ----
VLM_PROVIDER=gemini

# ---- Gemini (Google AI Studio) ----
GEMINI_API_KEY=
GEMINI_MODEL=

# ---- Mistral ----
MISTRAL_API_KEY=
MISTRAL_MODEL=

# ---- Cloudflare Workers AI ----
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=

# ---- Ollama (local) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# ---- Speech ----
WHISPER_MODEL_SIZE=small
WHISPER_COMPUTE_TYPE=int8

# ---- Images ----
MAX_IMAGE_SIDE=1024

# ---- Resilience / limits ----
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
VLM_TIMEOUT_SECONDS=40
VLM_MAX_RETRIES=3
MAX_UPLOAD_MB=10

# ---- Text to speech (edge-tts voices; list them with: edge-tts --list-voices) ----
TTS_VOICE_EN=en-US-AriaNeural
TTS_VOICE_FR=fr-FR-DeniseNeural
TTS_VOICE_AR=ar-MA-MounaNeural
TTS_TIMEOUT_SECONDS=20

# ---- Speech to text engine: gemini | whisper (whisper is always the fallback) ----
STT_ENGINE=gemini
GEMINI_STT_MODEL=gemini-3.5-flash-lite
GEMINI_RPM_LIMIT=12
