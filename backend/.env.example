# ---- General ----
APP_ENV=dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Active vision provider: gemini | mistral | cloudflare | ollama ----
VLM_PROVIDER=gemini

# ---- Gemini (Google AI Studio) ----
GEMINI_API_KEY=
GEMINI_MODEL=

# ---- Mistral ----
MISTRAL_API_KEY=
MISTRAL_MODEL=

# ---- Cloudflare Workers AI ----
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=

# ---- Ollama (local) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# ---- Speech ----
WHISPER_MODEL_SIZE=small
WHISPER_COMPUTE_TYPE=int8

# ---- Images ----
MAX_IMAGE_SIDE=1024
